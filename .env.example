# Aiven / MySQL
DB_HOST=your-aiven-host
DB_PORT=3306
DB_USER=avnadmin
DB_PASSWORD=your-aiven-password
DB_NAME=defaultdb
DB_SSL=true

# Admin account (used only if the admins table is empty)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-immediately

# Cookie signing secret: use a long random value
SESSION_SECRET=replace-with-a-long-random-string

PORT=3000
